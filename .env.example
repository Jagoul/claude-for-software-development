# Copy to .env and fill in. .env is git-ignored.
#
# Claude Code expands ${TRACKER_TOKEN} in .mcp.json from the environment of the shell that
# starts `claude`. It does not read .env itself, so load it first:
#
#   set -a; source .env; set +a
#   claude
#
# The demo tracker accepts any token shaped like tt_<8+ characters>.
TRACKER_TOKEN=tt_replace_me_with_your_token

# Optional. .mcp.json falls back to TB when this is unset: ${TRACKER_PROJECT:-TB}
# TRACKER_PROJECT=TB
