{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run check-claude-config *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "mcp__team-tracker__whoami",
      "mcp__team-tracker__list_issues",
      "mcp__team-tracker__get_issue"
    ],
    "ask": [
      "mcp__team-tracker__add_comment"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  },
  "enabledMcpjsonServers": ["team-tracker"],
  "hooks": {
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_instructions_loaded.py\""
          }
        ]
      }
    ]
  }
}
